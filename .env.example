# Database Configuration
# Local dev (no MySQL install): set USE_SQLITE=true
USE_SQLITE=true
SQLITE_PATH=./data/smart_academic.db

# MySQL mode: set USE_SQLITE=false and fill credentials below
MYSQL_URL=mysql://root:your_password@localhost:3306/smart_academic_v2
MYSQL_PUBLIC_URL=mysql://root:your_password@localhost:3306/smart_academic_v2
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=smart_academic_v2
DB_PORT=3306
PORT=3000
ALLOW_DEMO_LOGIN=false
